  <property name="styleSheet">
   <string>QMainWindow, QWidget#centralwidget { background-color: #1e2430; }
QLabel { color: #d8dee9; background: transparent; }
QLabel#titleLabel { color: #ffffff; font-size: 16pt; font-weight: 600; }
QLabel#subtitleLabel { color: #8b95a7; }
QLabel#label_2, QLabel#label_3 { color: #8b95a7; }
QGroupBox { background-color: #262d3b; border: 1px solid #343d4f; border-radius: 8px; margin-top: 10px; color: #e5e9f0; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 6px; }
QLineEdit { background-color: #1a1f29; border: 1px solid #3b4558; border-radius: 6px; padding: 0 8px; color: #e5e9f0; selection-background-color: #3b82f6; }
QLineEdit:focus { border-color: #3b82f6; }
QPushButton { background-color: #323b4d; color: #e5e9f0; border: 1px solid #445066; border-radius: 6px; font-weight: normal; }
QPushButton:hover { background-color: #3b4659; }
QPushButton:pressed { background-color: #2a3242; }
QPushButton#installButton { background-color: #3b82f6; border: none; color: #ffffff; font-weight: 600; }
QPushButton#installButton:hover { background-color: #4f91f7; }
QPushButton#installButton:pressed { background-color: #2f6fd8; }
QLabel#iconPreview { background-color: #1a1f29; border: 1px dashed #3b4558; border-radius: 6px; color: #5c677a; }
QLabel#statusLabel { background-color: #262d3b; border: 1px solid #343d4f; border-radius: 6px; padding: 0 12px; }
QLabel#statusLabel[state="ok"] { background-color: #1f3a2c; border-color: #2f5a42; color: #8fdfaa; }
QLabel#statusLabel[state="error"] { background-color: #3d2328; border-color: #6b3540; color: #f2a3ad; }</string>
